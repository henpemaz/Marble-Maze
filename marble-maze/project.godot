[layer_names]

3d_physics/layer_1="Unset"
3d_physics/layer_3="Level"
3d_physics/layer_4="Player"
3d_physics/layer_5="Gizmo"
3d_physics/layer_6="ActiveGizmo"
3d_physics/layer_7="Trackball"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/penetration_slop=0.001
jolt_physics_3d/simulation/continuous_cd_movement_threshold=0.25
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
